# Copy to .env for local development. Never commit .env.

# --- Required in production -------------------------------------------------
APP_ENV=development            # set to "production" on Cloud Run
FLASK_SECRET_KEY=change-me     # python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URL=                  # Neon/Supabase Postgres URL. Blank = local SQLite (dev only)
GEMINI_API_KEY=                # https://aistudio.google.com/apikey
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional -----------------------------------------------------------------
SITE_URL=https://quizlynotes.com
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash  # used if the main model is overloaded
AI_PROVIDER=gemini             # "fake" = offline sample data, no API key needed
ENABLE_DEV_LOGIN=true          # local only: /dev-login signs you in without Google
ENABLE_GUEST_DEMO=true         # the "try it" box on the landing pages
GENERATION_LIMIT=30 per hour;100 per day
GUEST_LIMIT=1 per minute;4 per day

# --- Billing (Pro) ------------------------------------------------------------
ADMIN_EMAILS=                  # comma-separated emails that always get Pro (e.g. yours)
STRIPE_SECRET_KEY=             # sk_live_... (or sk_test_... while testing)
STRIPE_WEBHOOK_SECRET=         # whsec_... from the webhook endpoint
STRIPE_PRICE_MONTHLY=          # price_... for £4.99/month
STRIPE_PRICE_YEARLY=           # price_... for £29.99/year
PRICE_MONTHLY_DISPLAY=£4.99
PRICE_YEARLY_DISPLAY=£29.99
PRICE_YEARLY_PER_MONTH_DISPLAY=£2.50
TRIAL_DAYS=7
# Plans and payments (off until Stripe is set up)
MONETISATION_ENABLED=false
